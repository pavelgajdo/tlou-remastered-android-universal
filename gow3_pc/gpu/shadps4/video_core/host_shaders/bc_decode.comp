// SPDX-License-Identifier: GPL-2.0-or-later
// Decodes BC1-BC7 blocks for drivers that cannot sample them (Samsung Xclipse lacks BC4-BC7,
// Mali lacks all of them). One invocation per 4x4 block, from a linear (detiled) buffer of
// blocks into a buffer of texels that the image copy then uploads: R8 (BC4), R8G8 (BC5),
// R16G16B16A16 float (BC6H) and R8G8B8A8 (BC1-3, BC7). The arithmetic follows SwiftShader's
// decoder; the part, anchor and BC6H mode tables are generated from its source.

#version 450 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// 0 BC1, 1 BC2, 2 BC3, 3 BC4, 4 BC4 signed, 5 BC5, 6 BC5 signed, 7 BC6H, 8 BC6H signed, 9 BC7
layout(constant_id = 0) const uint FORMAT = 0;

layout(std430, binding = 0) readonly buffer InputBlocks {
    uint in_words[];
};
layout(std430, binding = 1) writeonly buffer OutputTexels {
    uint out_words[];
};

layout(push_constant) uniform Params {
    uint in_offset;  // words
    uint out_offset; // words
    uint blocks_x;
    uint blocks_y;
    uint num_blocks; // blocks_x * blocks_y * slices
    uint in_row_blocks;
    uint in_slice_blocks;
    uint out_row_words;
    uint out_slice_words;
};

const bool IS_SIGNED = FORMAT == 4 || FORMAT == 6 || FORMAT == 8;
const uint BLOCK_WORDS = (FORMAT == 0 || FORMAT == 3 || FORMAT == 4) ? 2 : 4;
const uint TEXEL_BYTES = (FORMAT == 3 || FORMAT == 4) ? 1
                         : (FORMAT == 5 || FORMAT == 6) ? 2
                         : (FORMAT == 7 || FORMAT == 8) ? 8
                                                        : 4;

