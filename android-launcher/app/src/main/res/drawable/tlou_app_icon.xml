<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Release artwork: reuse the launcher hero (including the ANDROID label),
         retaining its original landscape proportions in a square app icon. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#101613"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:left="5dp" android:right="5dp"
          android:top="23dp" android:bottom="23dp"
          android:drawable="@drawable/tlou_hero"/>
    <!-- Hide the old artwork's tiny upper-right v0.1 watermark on the icon.
         The main launcher displays the actual package version instead. -->
    <item android:left="83dp" android:right="5dp" android:top="23dp" android:bottom="71dp">
        <shape android:shape="rectangle"><solid android:color="#101613"/></shape>
    </item>
</layer-list>
